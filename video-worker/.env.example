# Same Mongo database as the RSVP service. This process only consumes pending VideoJob rows.
MONGO_URI=

# Runway Dev. Default model is Seedance 2.0 Mini (480p/720p). Never set a 1080p ratio.
RUNWAYML_API_SECRET=
RUNWAY_API_BASE=https://api.dev.runwayml.com/v1
VIDEO_MODEL=seedance2_mini
# 720:1280 (720p vertical) or 480:854. 1080p values are ignored.
VIDEO_RATIO=720:1280

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Same sender as the RSVP WhatsApp bot (0585915109).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=
