PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
# Public site URL used for generated invitation/dashboard links.
# Local: http://localhost:5173
# Railway production: https://momoevent.up.railway.app
CLIENT_URL=http://localhost:5173

# Admin panel (/admin) — required for secure admin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Display name in couple welcome WhatsApp when created by admin (defaults to momoEVENT)
# ADMIN_DISPLAY_NAME=momoEVENT
# Optional: separate signing secret (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=your-random-secret-string

# Agent panel (/agent) — telephone RSVP workspace
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me-to-a-strong-password
# Optional: separate signing secret (defaults to AGENT_PASSWORD)
# AGENT_SECRET=your-random-secret-string

# Event Manager / Partner panel (/manager) — B2B couple management (no coupons)
EVENT_MANAGER_USERNAME=manager
EVENT_MANAGER_PASSWORD=change-me-to-a-strong-password
# Display name shown in the couple welcome WhatsApp (e.g. production company / manager name)
EVENT_MANAGER_DISPLAY_NAME=הפקות אדיה
# Optional: separate signing secret (defaults to EVENT_MANAGER_PASSWORD)
# EVENT_MANAGER_SECRET=your-random-secret-string

# ——— Couple system-access WhatsApp (Meta Content Template) ———
# Friendly name: couple_login_access_utility
# Language: he
# Category: UTILITY
#
# Body:
# ✨ 🥂 ✨
# שלום {{1}},
#
# מתרגשים איתכם לקראת האירוע!
#
# להלן פרטי הגישה שלך למערכת momoEVENT:
#
# שם משתמש: {{2}}
# סיסמה: {{3}}
#
# כניסה למערכת:
# {{4}}
#
# קישור להזמנה הדיגיטלית:
# {{5}}
#
# ✨ 🎉 ✨
#
# Samples: לינוי | linoy_itzik | TempPass123 | https://momoevent.up.railway.app/client/login | https://momoevent.up.railway.app/event/example
#
TWILIO_COUPLE_ACCESS_CONTENT_SID=
# Local/dev only:
# TWILIO_COUPLE_ACCESS_ALLOW_FREE_TEXT=true

# Twilio WhatsApp (bulk send from server)
TWILIO_ACCOUNT_SID=AC7c18a8a9bf9b38993e46ec0a74e59cdd
TWILIO_AUTH_TOKEN=a74f387da9cc98e505ad50e7bc4fdda2
# Virtual WhatsApp sender — must include whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
# Messaging Service used for outbound messages and inbound webhook routing
TWILIO_MESSAGING_SERVICE_SID=MG42b953157d0a2c06edaa8e088177c31b
# Twilio approved Content Template SID (e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# Template body:
# ✨ 🥂 ✨
# שלום {{1}},
#
# {{2}}
#
# האירוע יתקיים ב{{3}}
#
# נשמח אם תוכלו לאשר הגעתכם בקישור המצורף:
# {{4}}
#
# {{5}}
#
# ✨ 🎉 ✨
# Approved WhatsApp Content Template SID — MUST start with HX (not AC account SID)
# copy_event_invite_structured
TWILIO_CONTENT_SID=HXa32f37f28c9aeea9d824b1b53919c326
# Explicit standard template (copy_event_invite_structured). Falls back to the SID above.
TWILIO_STANDARD_INVITE_CONTENT_SID=HXa32f37f28c9aeea9d824b1b53919c326
# Premium interactive main template: copy_wedding_rsvp_buttons
TWILIO_COPY_WEDDING_RSVP_BUTTONS_CONTENT_SID=HX9eb2ac4178732bcfd5eb3e9609f9f626
# Approved follow-up templates: copy_rsvp_yes_followup / rsvp_declined_followup / rsvp_maybe_followup
TWILIO_RSVP_YES_FOLLOWUP_CONTENT_SID=HX39585c62a9bc7a739e93fa1cb2ea2015
TWILIO_RSVP_DECLINED_FOLLOWUP_CONTENT_SID=HX6a2e87ea5163b3a450a9bef6ca8d12c0
TWILIO_RSVP_MAYBE_FOLLOWUP_CONTENT_SID=HX9ff2e89f9c65862149743fd43a8c20c0
# Legacy alias (optional):
# TWILIO_WHATSAPP_TEMPLATE_SID=HXa32f37f28c9aeea9d824b1b53919c326

# Twilio compliance webhook (Twilio Console → HTTP, no trailing slash):
# https://momoevent.up.railway.app/api/webhooks/twilio-compliance
# Incoming WhatsApp webhook:
# https://momoevent.up.railway.app/api/webhooks/twilio-whatsapp
TWILIO_INBOUND_WEBHOOK_URL=https://momoevent.up.railway.app/api/webhooks/twilio-whatsapp
# Keep signature validation enabled in production. Set false only for local webhook testing.
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true
