PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority
# Public site URL used for generated invitation/dashboard links.
# Local: http://localhost:5173
# Railway production: https://momoevent.up.railway.app
CLIENT_URL=http://localhost:5173

# Admin panel (/admin) — required for secure admin access
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Display name in couple welcome WhatsApp when created by admin (defaults to momoEVENT)
# ADMIN_DISPLAY_NAME=momoEVENT
# Optional: separate signing secret (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=your-random-secret-string

# Agent panel (/agent) — telephone RSVP workspace (multi-agent)
# Preferred: JSON list of agents (id is stored on clients as createdByAgentId)
# AGENTS_JSON=[{"id":"agent1","username":"agent1","password":"change-me","displayName":"סוכן 1"}]
# Legacy single-agent fallback (id becomes "default"):
AGENT_USERNAME=agent
AGENT_PASSWORD=change-me-to-a-strong-password
# Optional: separate signing secret (defaults to AGENT_PASSWORD / AGENT_USERNAME)
# AGENT_SECRET=your-random-secret-string
# AGENT_DISPLAY_NAME=סוכן

# Event Manager / Partner panel (/manager) — B2B couple management (no coupons)
# Credentials are env-only. Only SYSTEM_ADMIN/ops may provision EVENT_MANAGER accounts (no in-app create).
EVENT_MANAGER_USERNAME=manager
EVENT_MANAGER_PASSWORD=change-me-to-a-strong-password
# Display name shown in the couple welcome WhatsApp (e.g. production company / manager name)
EVENT_MANAGER_DISPLAY_NAME=הפקות אדיה
# Optional: separate signing secret (defaults to EVENT_MANAGER_PASSWORD)
# EVENT_MANAGER_SECRET=your-random-secret-string

# ——— Couple welcome WhatsApp (2 templates) ———
# 1) copy_welcome_momoevent — Call to action (Approved)
#    SID: HXf6a85f46fa5f87c6cedd853627508797
#    {{1}} = Couple name                 sample: לינוי
#    {{2}} = Event id (URL path only)    sample: 6a1f05f4a2f2f5939554a5c9
#    Buttons: Visit Website (login) + Visit Website (invitation)
#
TWILIO_COUPLE_ACCESS_CONTENT_SID=HXf6a85f46fa5f87c6cedd853627508797
#
# 2) copy_get_login_credentials — Quick Reply (Approved UTILITY)
#    Friendly name: copy_get_login_credentials
#    Content SID: HXaa49007744d72933b0d6db852e715ad6
#    Button title: 🔑 לקבלת פרטי הגישה
#    Button id / payload: GET_CREDENTIALS
#
TWILIO_GET_LOGIN_CREDENTIALS_CONTENT_SID=HXaa49007744d72933b0d6db852e715ad6
#
# On create-client the server sends welcome immediately, then schedules
# get_login_credentials ~1 minute later (does not block the API response).
# Override delay (ms): TWILIO_CREDENTIALS_QR_DELAY_MS=60000
#
# Webhook /api/webhooks/twilio-whatsapp (alias: /api/webhooks/whatsapp)
# handles GET_CREDENTIALS with a free-text session message (username + passcode).
# Audit: SystemAuditLog source=WHATSAPP_QUICK_REPLY
#
# Support phone shown when number is not linked to an account / credentials footer:
MOMOEVENT_SUPPORT_PHONE=0585915109
#
# Local/dev only:
# TWILIO_COUPLE_ACCESS_ALLOW_FREE_TEXT=true
# TWILIO_CREDENTIALS_QR_DELAY_MS=5000

# ——— Day-of table number WhatsApp (Meta Content Template) ———
# Friendly name: copy_event_table_number_utility
# Language: he
# Category: UTILITY (WhatsApp approved)
# Type: Text
# Buttons: none
#
# Body (approved — variable order must match the app):
# ✨ 🥂 ✨
#
# שלום {{1}},
#
# תודה שהגעתם ל{{2}}!
#
# השולחן שלכם הוא:
# {{3}}
#
# מחכים לחגוג איתכם,
# {{4}}
#
# ✨ 🥂 ✨
#
# Variable meanings (Twilio Content Variables):
# {{1}} = Guest full name            sample: יצחק כהן
# {{2}} = Event type                 sample: חתונה
# {{3}} = Table name/number          sample: 12
# {{4}} = Hosts / couple names       sample: לינוי ויצחק
#
TWILIO_TABLE_NUMBER_CONTENT_SID=HX405726f9479a1d07e2fe8fcbe77a6be4
# Local/dev only (bypasses Meta template — do NOT enable in production):
# TWILIO_TABLE_NUMBER_ALLOW_FREE_TEXT=true

# Event cover images (Cloudinary) — required for public invitation performance
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Twilio WhatsApp (bulk send from server)
# SECURITY: use real credentials only in private env vars / Railway secrets — never commit them.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Virtual WhatsApp sender — must include whatsapp: prefix, e.g. whatsapp:+14155238886
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
# Messaging Service used for outbound messages and inbound webhook routing
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Twilio approved Content Template SID (e.g. HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx)
# Template body:
# ✨ 🥂 ✨
# שלום {{1}},
#
# {{2}}
#
# האירוע יתקיים ב{{3}}
#
# נשמח אם תוכלו לאשר הגעתכם בקישור המצורף:
# {{4}}
#
# {{5}}
#
# ✨ 🎉 ✨
# Approved WhatsApp Content Template SID — MUST start with HX (not AC account SID)
# Standard invite (Text): copy_copy_event_invite_structured
TWILIO_CONTENT_SID=HXbdfde344006c1b595fe91e738f9972c5
TWILIO_STANDARD_INVITE_CONTENT_SID=HXbdfde344006c1b595fe91e738f9972c5
# Premium interactive main template: copy_copy_wedding_rsvp_buttons
TWILIO_COPY_WEDDING_RSVP_BUTTONS_CONTENT_SID=HX0ed4e1d2438f2e69bfd54610a127984d
# Follow-ups: copy_copy_rsvp_yes_followup / copy_rsvp_declined_followup / copy_rsvp_maybe_followup
TWILIO_RSVP_YES_FOLLOWUP_CONTENT_SID=HX206e8cf197078c26f5258f7799471d9a
TWILIO_RSVP_DECLINED_FOLLOWUP_CONTENT_SID=HX3da07cfd53de307aac93c12cd440e61a
TWILIO_RSVP_MAYBE_FOLLOWUP_CONTENT_SID=HXc9ad6f35c5a025091c86fb9c699aa2a4
# Legacy alias (optional):
# TWILIO_WHATSAPP_TEMPLATE_SID=HXbdfde344006c1b595fe91e738f9972c5

# Twilio compliance webhook (Twilio Console → HTTP, no trailing slash):
# https://momoevent.up.railway.app/api/webhooks/twilio-compliance
# Incoming WhatsApp webhook:
# https://momoevent.up.railway.app/api/webhooks/twilio-whatsapp
# Alias: https://momoevent.up.railway.app/api/webhooks/whatsapp
TWILIO_INBOUND_WEBHOOK_URL=https://momoevent.up.railway.app/api/webhooks/twilio-whatsapp
# Keep signature validation enabled in production. Set false only for local webhook testing.
TWILIO_VALIDATE_WEBHOOK_SIGNATURE=true
